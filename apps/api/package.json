{
  "name": "@pro-now/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start:ts": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --alias:@pro-now/config=../../packages/config/src/index.ts --alias:@pro-now/types=../../packages/types/src/index.ts --alias:@pro-now/validation=../../packages/validation/src/index.ts --outfile=dist/server.js --sourcemap",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed-dev.ts",
    "dev:pulse": "tsx scripts/dev-pulse.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@pro-now/config": "*",
    "@pro-now/types": "*",
    "@pro-now/validation": "*",
    "@sentry/node": "^11.1.0",
    "better-auth": "^1.7.6",
    "cuid": "^3.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^7.0.13",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^5.0.2"
  }
}
